# Copy to .env.local for local dev, and set the same in Vercel for production.

# Production URL (no trailing slash). Used for canonical/OG/sitemap.
NEXT_PUBLIC_SITE_URL="https://example.com"

# Inquiry form email delivery (https://resend.com). Without a key, the form still
# works — it accepts + logs the submission but does not send. Add the key to
# actually email the owner.
# RESEND_API_KEY=""
# Where inquiries are sent (defaults to site.email if unset).
# INQUIRY_TO_EMAIL=""
# From address (defaults to Resend's shared sender until a domain is verified).
# INQUIRY_FROM_EMAIL=""
